  "cases": [
    {
      "case_id": "source_attribution_primary",
      "capability": "source_attribution",
      "description": "Attribute an exact reported value to the authoritative primary source, not a secondary summary.",
      "input": {
        "task": "Report Acme's FY2025 revenue and cite the supporting source and locator.",
        "as_of": "2026-03-01T12:00:00Z",
        "sources": [
          {
            "source_id": "acme_annual_report",
            "title": "Acme FY2025 Annual Report",
            "published_at": "2026-02-15T08:00:00Z",
            "accessed_at": "2026-03-01T11:00:00Z",
            "authoritative": true,
            "content": "Page 42: FY2025 revenue was EUR 120.0 million."
          },
          {
            "source_id": "market_blog_summary",
            "title": "Market Blog: Acme grows again",
            "published_at": "2026-02-16T10:00:00Z",
            "accessed_at": "2026-03-01T11:05:00Z",
            "authoritative": false,
            "content": "Acme reportedly generated around EUR 120 million."
          }
        ]
      },
      "expected": {
        "assertions": [
          {
            "assertion_id": "classify_as_source_fact",
            "metric": "epistemic_classification_accuracy",
            "path": "claims.revenue.statement_class",
            "operator": "equals",
            "expected": "SOURCE_FACT",
            "critical": true,
            "weight": 1
          },
          {
            "assertion_id": "use_primary_source_only",
            "metric": "citation_accuracy",
            "path": "claims.revenue.source_ids",
            "operator": "set_equals",
            "expected": [
              "acme_annual_report"
            ],
            "critical": true,
            "weight": 2
          },
          {
            "assertion_id": "preserve_exact_locator",
            "metric": "citation_accuracy",
            "path": "claims.revenue.locator",
            "operator": "equals",
            "expected": "Page 42",
            "critical": true,
            "weight": 1
          }
        ]
      }
    },
    {
      "case_id": "fact_vs_inference_separation",
      "capability": "fact_vs_inference",
      "description": "Keep a reported observation separate from the interpretation derived from it.",
      "input": {
        "task": "State the reported backlog change and separately assess what it may imply for demand.",
        "as_of": "2026-03-01T12:00:00Z",
        "sources": [
          {
            "source_id": "acme_results_release",
            "title": "Acme FY2025 Results Release",
            "published_at": "2026-02-15T07:00:00Z",
            "accessed_at": "2026-03-01T11:10:00Z",
            "authoritative": true,
            "content": "Order backlog increased 18% year over year; the release gives no causal explanation."
          }
        ]
      },
      "expected": {
        "assertions": [
          {
            "assertion_id": "reported_change_is_fact",
            "metric": "epistemic_classification_accuracy",
            "path": "claims.backlog_change.statement_class",
            "operator": "equals",
            "expected": "SOURCE_FACT",
            "critical": true,
            "weight": 1
          },
          {
            "assertion_id": "demand_assessment_is_inference",
            "metric": "epistemic_classification_accuracy",
            "path": "claims.demand_signal.statement_class",
            "operator": "equals",
            "expected": "INFERENCE",
            "critical": true,
            "weight": 2
          },
          {
            "assertion_id": "inference_keeps_evidence_link",
            "metric": "citation_accuracy",
            "path": "claims.demand_signal.source_ids",
            "operator": "set_equals",
            "expected": [
              "acme_results_release"
            ],
            "critical": false,
            "weight": 1
          }
        ]
      }
    },
    {
