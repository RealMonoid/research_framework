            "authoritative": true,
            "content": "The policy rate was set to 3.00%."
          },
          {
            "source_id": "central_bank_2026",
            "title": "Central Bank Decision February 2026",
            "published_at": "2026-02-12T13:00:00Z",
            "accessed_at": "2026-03-01T11:26:00Z",
            "authoritative": true,
            "content": "The policy rate was set to 2.25%."
          }
        ]
      },
      "expected": {
        "assertions": [
          {
            "assertion_id": "use_current_source",
            "metric": "source_freshness_rate",
            "path": "claims.policy_rate.source_ids",
            "operator": "set_equals",
            "expected": [
              "central_bank_2026"
            ],
            "critical": true,
            "weight": 2
          },
          {
            "assertion_id": "flag_no_stale_use",
            "metric": "source_freshness_rate",
            "path": "stale_source_used",
            "operator": "equals",
            "expected": false,
            "critical": true,
            "weight": 1
          },
          {
            "assertion_id": "return_current_value",
            "metric": "source_freshness_rate",
            "path": "claims.policy_rate.value",
            "operator": "approx_equals",
            "expected": 2.25,
            "tolerance": 0.000001,
            "critical": true,
            "weight": 1
          }
        ]
      }
    },
    {
      "case_id": "calculation_from_sourced_inputs",
      "capability": "calculation",
      "description": "Calculate a growth rate from sourced operands and classify the output as calculated.",
      "input": {
        "task": "Calculate revenue growth from FY2024 to FY2025 as a decimal.",
        "as_of": "2026-03-01T12:00:00Z",
        "sources": [
          {
            "source_id": "acme_financial_table",
            "title": "Acme Five-Year Financial Table",
            "published_at": "2026-02-15T08:00:00Z",
            "accessed_at": "2026-03-01T11:30:00Z",
            "authoritative": true,
            "content": "Revenue: FY2024 EUR 96.0 million; FY2025 EUR 120.0 million."
          }
        ]
      },
      "expected": {
        "assertions": [
          {
            "assertion_id": "classify_calculated_value",
            "metric": "epistemic_classification_accuracy",
            "path": "claims.revenue_growth.statement_class",
            "operator": "equals",
            "expected": "CALCULATED_VALUE",
            "critical": true,
            "weight": 1
          },
          {
            "assertion_id": "calculate_growth_correctly",
            "metric": "calculation_accuracy",
            "path": "claims.revenue_growth.value",
            "operator": "approx_equals",
            "expected": 0.25,
            "tolerance": 0.000001,
            "critical": true,
            "weight": 2
          },
          {
            "assertion_id": "record_formula",
            "metric": "calculation_accuracy",
            "path": "claims.revenue_growth.formula",
            "operator": "equals",
            "expected": "(120.0 - 96.0) / 96.0",
            "critical": false,
            "weight": 1
          },
          {
            "assertion_id": "link_calculation_to_inputs",
            "metric": "citation_accuracy",
            "path": "claims.revenue_growth.source_ids",
            "operator": "set_equals",
            "expected": [
              "acme_financial_table"
            ],
            "critical": true,
            "weight": 1
          }
        ]
      }
    },
