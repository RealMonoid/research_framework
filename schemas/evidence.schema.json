{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-framework:schema:evidence:1.0.0",
  "title": "Research Evidence Set",
  "description": "Claim-zentrierte Beweiskette von Quelle und Fundstelle über extrahierten Fakt und Ableitung bis zur Hypothesenauswirkung.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_set_id",
    "research",
    "run_id",
    "created_at",
    "overall_evidence_assessment",
    "sources",
    "claims",
    "conflicts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "evidence_set_id": {
      "$ref": "#/$defs/uuid"
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_id",
        "research_version"
      ],
      "properties": {
        "research_id": {
          "$ref": "#/$defs/stableId"
        },
        "research_version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "run_id": {
      "$ref": "#/$defs/uuid"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "overall_evidence_assessment": {
      "$ref": "#/$defs/evidenceAssessment"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor_id"
      ],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "AGENT",
            "HUMAN",
            "SYSTEM"
          ]
        },
        "actor_id": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "assessmentCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "outcome",
        "evidence_refs"
      ],
      "properties": {
        "criterion_id": {
          "$ref": "#/$defs/stableId"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_APPLICABLE"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "evidenceAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grade",
        "ruleset_version",
        "evaluated_at",
        "checks"
      ],
      "properties": {
        "grade": {
          "type": "string",
          "enum": [
            "SUFFICIENT",
            "LIMITED",
            "INSUFFICIENT"
          ],
          "description": "Muss durch das angegebene Ruleset ermittelt werden und darf keine freie LLM-Selbsteinschätzung sein."
        },
        "ruleset_version": {
          "$ref": "#/$defs/version"
        },
        "evaluated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assessmentCheck"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "title",
        "publisher",
        "uri",
        "published_at",
        "retrieved_at",
        "version_or_vintage",
        "snapshot_hash"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/stableId"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "PRIMARY_DOCUMENT",
            "OFFICIAL_DATA",
            "ACADEMIC",
            "COMPANY_DISCLOSURE",
            "NEWS",
            "SECONDARY_ANALYSIS",
            "EXPERT_INPUT",
            "OTHER"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "uri": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri",
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "published_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_at": {
          "$ref": "#/$defs/timestamp"
        },
        "version_or_vintage": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "snapshot_hash": {
          "$ref": "#/$defs/sha256"
        },
        "archive_uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 4000
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator_type",
        "value"
      ],
      "properties": {
        "locator_type": {
          "type": "string",
          "enum": [
            "PAGE",
            "SECTION",
            "PARAGRAPH",
            "TABLE",
            "FIGURE",
            "CELL",
            "TIMESTAMP",
            "RECORD",
            "QUERY_RESULT",
            "OTHER"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "exact_excerpt": {
          "type": "string",
          "maxLength": 4000,
          "description": "Optionaler kurzer Belegauszug; Urheberrechts- und Lizenzgrenzen sind einzuhalten."
        }
      }
    },
    "evidenceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_link_id",
        "source_id",
        "locator",
        "extracted_fact",
        "extracted_fact_hash",
        "relation",
        "extraction_method",
        "human_verified"
      ],
      "properties": {
        "evidence_link_id": {
          "$ref": "#/$defs/stableId"
        },
        "source_id": {
          "$ref": "#/$defs/stableId"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "extracted_fact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "extracted_fact_hash": {
          "$ref": "#/$defs/sha256"
        },
        "relation": {
          "type": "string",
          "enum": [
            "SUPPORTS",
            "CONTRADICTS",
            "CONTEXTUALIZES"
          ]
        },
        "extraction_method": {
          "type": "string",
          "enum": [
            "MANUAL",
            "DETERMINISTIC",
            "LLM"
          ]
        },
        "human_verified": {
          "type": "boolean"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "relation"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/stableId"
        },
        "relation": {
          "type": "string",
          "enum": [
            "DERIVED_FROM",
            "CALCULATED_FROM",
            "ASSUMES",
            "QUALIFIES",
            "CONTRADICTS"
          ]
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "expression_or_procedure",
        "input_claim_ids",
        "assumptions"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "expression_or_procedure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "input_claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "thesisImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "effect",
        "materiality",
        "rationale"
      ],
      "properties": {
        "hypothesis_id": {
          "$ref": "#/$defs/stableId"
        },
        "effect": {
          "type": "string",
          "enum": [
            "STRENGTHENS",
            "WEAKENS",
            "FALSIFIES",
            "SUPPORTS_COUNTERHYPOTHESIS",
            "NO_DIRECT_IMPACT"
          ]
        },
        "materiality": {
          "type": "string",
          "enum": [
            "MATERIAL",
            "IMMATERIAL",
            "UNKNOWN"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "forecastDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "horizon_end",
        "target",
        "resolution_rule"
      ],
      "properties": {
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "horizon_end": {
          "$ref": "#/$defs/timestamp"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "resolution_rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "estimateDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "assumptions",
        "uncertainty_description"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "uncertainty_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "humanJudgmentDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "judge",
        "rationale"
      ],
      "properties": {
        "judge": {
          "$ref": "#/$defs/actor"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_revision",
        "claim_class",
        "research_claim_level",
        "statement",
        "origin",
        "as_of",
        "valid_until",
        "status",
        "supersedes_claim_id",
        "recorded_at",
        "recorded_by",
        "evidence_assessment",
        "evidence_links",
        "dependencies",
        "derivation",
        "forecast_details",
        "estimate_details",
        "human_judgment_details",
        "thesis_impacts",
        "decision_refs",
        "conflict_refs"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/stableId"
        },
        "claim_revision": {
          "type": "integer",
          "minimum": 1
        },
        "claim_class": {
          "type": "string",
          "enum": [
            "SOURCE_FACT",
            "CALCULATED_VALUE",
            "ESTIMATE",
            "INFERENCE",
            "FORECAST",
            "HUMAN_JUDGMENT"
          ]
        },
        "research_claim_level": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "ASSOCIATIONAL_PREDICTIVE",
                "INTERVENTIONAL",
                "COUNTERFACTUAL"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Orthogonaler fachlicher Claim-Level aus 01 §5; null, wenn die einzelne Aussage keinen solchen Level erhebt."
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "origin": {
          "type": "string",
          "enum": [
            "MODEL",
            "TOOL",
            "HUMAN",
            "IMPORTED"
          ]
        },
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "valid_until": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "DRAFT",
            "ACTIVE",
            "DISPUTED",
            "SUPERSEDED",
            "RETRACTED"
          ]
        },
        "supersedes_claim_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        },
        "recorded_by": {
          "$ref": "#/$defs/actor"
        },
        "evidence_assessment": {
          "$ref": "#/$defs/evidenceAssessment"
        },
        "evidence_links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceLink"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "derivation": {
          "oneOf": [
            {
              "$ref": "#/$defs/derivation"
            },
            {
              "type": "null"
            }
          ]
        },
        "forecast_details": {
          "oneOf": [
            {
              "$ref": "#/$defs/forecastDetails"
            },
            {
              "type": "null"
            }
          ]
        },
        "estimate_details": {
          "oneOf": [
            {
              "$ref": "#/$defs/estimateDetails"
            },
            {
              "type": "null"
            }
          ]
        },
        "human_judgment_details": {
          "oneOf": [
            {
              "$ref": "#/$defs/humanJudgmentDetails"
            },
            {
              "type": "null"
            }
          ]
        },
        "thesis_impacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/thesisImpact"
          }
        },
        "decision_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "conflict_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "claim_class"
            ],
            "properties": {
              "claim_class": {
                "const": "SOURCE_FACT"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_links": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "claim_class"
            ],
            "properties": {
              "claim_class": {
                "enum": [
                  "CALCULATED_VALUE",
                  "INFERENCE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "derivation": {
                "$ref": "#/$defs/derivation"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "claim_class"
            ],
            "properties": {
              "claim_class": {
                "const": "ESTIMATE"
              }
            }
          },
          "then": {
            "properties": {
              "estimate_details": {
                "$ref": "#/$defs/estimateDetails"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "claim_class"
            ],
            "properties": {
              "claim_class": {
                "const": "FORECAST"
              }
            }
          },
          "then": {
            "properties": {
              "forecast_details": {
                "$ref": "#/$defs/forecastDetails"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "claim_class"
            ],
            "properties": {
              "claim_class": {
                "const": "HUMAN_JUDGMENT"
              }
            }
          },
          "then": {
            "properties": {
              "human_judgment_details": {
                "$ref": "#/$defs/humanJudgmentDetails"
              }
            }
          }
        }
      ]
    },
    "conflictResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolved_at",
        "resolved_by",
        "decision",
        "rationale",
        "surviving_claim_ids"
      ],
      "properties": {
        "resolved_at": {
          "$ref": "#/$defs/timestamp"
        },
        "resolved_by": {
          "$ref": "#/$defs/actor"
        },
        "decision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "surviving_claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_id",
        "conflict_type",
        "severity",
        "status",
        "detected_at",
        "description",
        "claim_ids",
        "source_ids",
        "resolution"
      ],
      "properties": {
        "conflict_id": {
          "$ref": "#/$defs/stableId"
        },
        "conflict_type": {
          "type": "string",
          "enum": [
            "FACTUAL",
            "TEMPORAL",
            "METHODOLOGICAL",
            "SEMANTIC",
            "SOURCE_DISAGREEMENT"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "OPEN",
            "RESOLVED",
            "ACCEPTED_UNCERTAINTY"
          ]
        },
        "detected_at": {
          "$ref": "#/$defs/timestamp"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "claim_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "resolution": {
          "oneOf": [
            {
              "$ref": "#/$defs/conflictResolution"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "RESOLVED"
              }
            }
          },
          "then": {
            "properties": {
              "resolution": {
                "$ref": "#/$defs/conflictResolution"
              }
            }
          }
        }
      ]
    }
  }
}
