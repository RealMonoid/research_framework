{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-framework:schema:research-fingerprint-check:1.0.0",
  "title": "Research Fingerprint Check",
  "description": "Deterministic comparison that either confirms continuity or creates a visible, non-effective change proposal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "check_id",
    "checked_at",
    "routing_decision_ref",
    "guard_mode",
    "baseline_fingerprint_ref",
    "baseline_fingerprint_sha256",
    "candidate_fingerprint_ref",
    "candidate_fingerprint_sha256",
    "overall_status",
    "changes",
    "proposal",
    "plain_language_summary",
    "candidate_may_become_effective"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "check_id": {"$ref": "#/$defs/stableId"},
    "checked_at": {"$ref": "#/$defs/timestamp"},
    "routing_decision_ref": {"$ref": "#/$defs/stableId"},
    "guard_mode": {
      "type": "string",
      "enum": ["PRESERVE_EFFECTIVE", "NEW_RESEARCH_CREATION", "NOT_APPLICABLE"]
    },
    "baseline_fingerprint_ref": {"$ref": "#/$defs/nullableStableId"},
    "baseline_fingerprint_sha256": {"$ref": "#/$defs/nullableSha256"},
    "candidate_fingerprint_ref": {"$ref": "#/$defs/nullableStableId"},
    "candidate_fingerprint_sha256": {"$ref": "#/$defs/nullableSha256"},
    "overall_status": {
      "type": "string",
      "enum": ["UNCHANGED", "CHANGE_PROPOSED", "NOT_COMPARABLE_NEW_RESEARCH", "NOT_APPLICABLE"]
    },
    "changes": {
      "type": "array",
      "items": {"$ref": "#/$defs/change"}
    },
    "proposal": {
      "oneOf": [
        {"$ref": "#/$defs/proposal"},
        {"type": "null"}
      ]
    },
    "plain_language_summary": {"$ref": "#/$defs/shortText"},
    "candidate_may_become_effective": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"overall_status": {"const": "CHANGE_PROPOSED"}}, "required": ["overall_status"]},
      "then": {
        "properties": {
          "changes": {"minItems": 1},
          "proposal": {"$ref": "#/$defs/proposal"},
          "candidate_may_become_effective": {"const": false},
          "baseline_fingerprint_ref": {"$ref": "#/$defs/stableId"},
          "candidate_fingerprint_ref": {"$ref": "#/$defs/stableId"}
        }
      }
    },
    {
      "if": {"properties": {"overall_status": {"const": "UNCHANGED"}}, "required": ["overall_status"]},
      "then": {
        "properties": {
          "changes": {"maxItems": 0},
          "proposal": {"type": "null"},
          "candidate_may_become_effective": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"overall_status": {"enum": ["NOT_COMPARABLE_NEW_RESEARCH", "NOT_APPLICABLE"]}}, "required": ["overall_status"]},
      "then": {
        "properties": {
          "changes": {"maxItems": 0},
          "proposal": {"type": "null"},
          "baseline_fingerprint_ref": {"type": "null"},
          "baseline_fingerprint_sha256": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,199}$"},
    "nullableStableId": {"oneOf": [{"$ref": "#/$defs/stableId"}, {"type": "null"}]},
    "timestamp": {"type": "string", "format": "date-time"},
    "shortText": {"type": "string", "minLength": 1, "maxLength": 4000},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json_pointer", "before_present", "after_present", "before", "after"],
      "properties": {
        "json_pointer": {"type": "string", "pattern": "^/"},
        "before_present": {"type": "boolean"},
        "after_present": {"type": "boolean"},
        "before": {},
        "after": {}
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "status",
        "effective_fingerprint_ref",
        "candidate_fingerprint_ref",
        "changed_paths",
        "decision_required",
        "effect_if_accepted"
      ],
      "properties": {
        "proposal_id": {"$ref": "#/$defs/stableId"},
        "status": {"const": "PENDING_USER_DECISION"},
        "effective_fingerprint_ref": {"$ref": "#/$defs/stableId"},
        "candidate_fingerprint_ref": {"$ref": "#/$defs/stableId"},
        "changed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^/"}
        },
        "decision_required": {"const": true},
        "effect_if_accepted": {"const": "CREATE_NEW_RESEARCH_VERSION"}
      }
    }
  }
}
