{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-framework:schema:research-identity-check:1.0.0",
  "title": "Research Identity Handoff Check",
  "description": "Deterministic before/after comparison of the six research-identity dimensions around a specialist handoff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "check_id",
    "checked_at",
    "routing_decision_ref",
    "guard_mode",
    "before_identity",
    "after_identity",
    "comparisons",
    "overall_status",
    "changed_dimensions",
    "plain_language_summary",
    "handoff_may_be_accepted"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "check_id": {"$ref": "#/$defs/stableId"},
    "checked_at": {"$ref": "#/$defs/timestamp"},
    "routing_decision_ref": {"$ref": "#/$defs/stableId"},
    "guard_mode": {
      "type": "string",
      "enum": ["PRESERVE_EXISTING", "NEW_IDENTITY_CREATION", "NOT_APPLICABLE"]
    },
    "before_identity": {"$ref": "#/$defs/nullableIdentity"},
    "after_identity": {"$ref": "#/$defs/nullableIdentity"},
    "comparisons": {
      "type": "array",
      "items": {"$ref": "#/$defs/comparison"},
      "allOf": [
        {"contains": {"properties": {"dimension": {"const": "research_question"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension": {"const": "strategy"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension": {"const": "market"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension": {"const": "time_horizon"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension": {"const": "trigger"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension": {"const": "target"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "UNCHANGED",
        "DRIFT_DETECTED",
        "NOT_COMPARABLE_NEW_IDENTITY",
        "NOT_APPLICABLE"
      ]
    },
    "changed_dimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/dimension"}
    },
    "plain_language_summary": {"$ref": "#/$defs/shortText"},
    "handoff_may_be_accepted": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"guard_mode": {"const": "PRESERVE_EXISTING"}},
        "required": ["guard_mode"]
      },
      "then": {
        "properties": {
          "before_identity": {"$ref": "#/$defs/researchIdentity"},
          "after_identity": {"$ref": "#/$defs/researchIdentity"},
          "comparisons": {"minItems": 6, "maxItems": 6},
          "overall_status": {"enum": ["UNCHANGED", "DRIFT_DETECTED"]}
        }
      }
    },
    {
      "if": {
        "properties": {"overall_status": {"const": "UNCHANGED"}},
        "required": ["overall_status"]
      },
      "then": {
        "properties": {
          "changed_dimensions": {"maxItems": 0},
          "handoff_may_be_accepted": {"const": true}
        }
      }
    },
    {
      "if": {
        "properties": {"overall_status": {"const": "DRIFT_DETECTED"}},
        "required": ["overall_status"]
      },
      "then": {
        "properties": {
          "changed_dimensions": {"minItems": 1},
          "handoff_may_be_accepted": {"const": false}
        }
      }
    },
    {
      "if": {
        "properties": {"guard_mode": {"const": "NEW_IDENTITY_CREATION"}},
        "required": ["guard_mode"]
      },
      "then": {
        "properties": {
          "before_identity": {"type": "null"},
          "after_identity": {"type": "null"},
          "comparisons": {"maxItems": 0},
          "overall_status": {"const": "NOT_COMPARABLE_NEW_IDENTITY"},
          "changed_dimensions": {"maxItems": 0},
          "handoff_may_be_accepted": {"const": true}
        }
      }
    },
    {
      "if": {
        "properties": {"guard_mode": {"const": "NOT_APPLICABLE"}},
        "required": ["guard_mode"]
      },
      "then": {
        "properties": {
          "before_identity": {"type": "null"},
          "after_identity": {"type": "null"},
          "comparisons": {"maxItems": 0},
          "overall_status": {"const": "NOT_APPLICABLE"},
          "changed_dimensions": {"maxItems": 0},
          "handoff_may_be_accepted": {"const": true}
        }
      }
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,199}$"
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "shortText": {"type": "string", "minLength": 1, "maxLength": 2000},
    "dimension": {
      "type": "string",
      "enum": [
        "research_question",
        "strategy",
        "market",
        "time_horizon",
        "trigger",
        "target"
      ]
    },
    "identityComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "statement"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["DEFINED", "UNRESOLVED", "NOT_APPLICABLE"]
        },
        "statement": {
          "oneOf": [
            {"$ref": "#/$defs/shortText"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"enum": ["DEFINED", "UNRESOLVED"]}},
            "required": ["status"]
          },
          "then": {"properties": {"statement": {"$ref": "#/$defs/shortText"}}}
        },
        {
          "if": {
            "properties": {"status": {"const": "NOT_APPLICABLE"}},
            "required": ["status"]
          },
          "then": {"properties": {"statement": {"type": "null"}}}
        }
      ]
    },
    "researchIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_question",
        "strategy",
        "market",
        "time_horizon",
        "trigger",
        "target"
      ],
      "properties": {
        "research_question": {"$ref": "#/$defs/identityComponent"},
        "strategy": {"$ref": "#/$defs/identityComponent"},
        "market": {"$ref": "#/$defs/identityComponent"},
        "time_horizon": {"$ref": "#/$defs/identityComponent"},
        "trigger": {"$ref": "#/$defs/identityComponent"},
        "target": {"$ref": "#/$defs/identityComponent"}
      }
    },
    "nullableIdentity": {
      "oneOf": [
        {"$ref": "#/$defs/researchIdentity"},
        {"type": "null"}
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "before", "after", "status"],
      "properties": {
        "dimension": {"$ref": "#/$defs/dimension"},
        "before": {"$ref": "#/$defs/identityComponent"},
        "after": {"$ref": "#/$defs/identityComponent"},
        "status": {"type": "string", "enum": ["UNCHANGED", "CHANGED"]}
      }
    }
  }
}
