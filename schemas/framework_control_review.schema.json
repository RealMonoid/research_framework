{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-framework:schema:framework-control-review:1.0.0",
  "title": "Framework Control Review",
  "description": "Bounded, provider-neutral review of an observable workflow-control risk. It cannot change the effective research state or substitute for a domain specialist.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "created_at",
    "updated_at",
    "agent_contract_version",
    "mode",
    "trigger",
    "objective",
    "mandatory_requirements",
    "definition_of_done",
    "evidence_refs",
    "observed_signal",
    "finding",
    "corrective_action",
    "regression",
    "unsupported_claims",
    "disposition",
    "research_state_unchanged",
    "no_private_chain_of_thought"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "review_id": {"$ref": "#/$defs/stableId"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "agent_contract_version": {"const": "1.0.0"},
    "mode": {
      "type": "string",
      "enum": [
        "FRAMEWORK_RED_TEAM",
        "STRATEGY_LAUNDERING",
        "SCOPE_LAUNDERING",
        "LOOPHOLE_HUNT",
        "ROOT_CAUSE_VALIDATION",
        "RULE_CONFLICT",
        "MEMORY_VALIDATION"
      ]
    },
    "trigger": {
      "type": "string",
      "enum": [
        "EXPLICIT_USER_REQUEST",
        "OBSERVED_BYPASS_SIGNAL",
        "DETERMINISTIC_CHECK_FAILURE",
        "HANDOFF_OR_COMPRESSION",
        "INSTRUCTION_CONFLICT",
        "STALE_MEMORY_CANDIDATE"
      ]
    },
    "objective": {"$ref": "#/$defs/shortText"},
    "mandatory_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/shortText"}
    },
    "definition_of_done": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/shortText"}
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableId"}
    },
    "observed_signal": {"$ref": "#/$defs/shortText"},
    "finding": {"$ref": "#/$defs/finding"},
    "corrective_action": {"$ref": "#/$defs/correctiveAction"},
    "regression": {"$ref": "#/$defs/regression"},
    "unsupported_claims": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/shortText"}
    },
    "disposition": {
      "type": "string",
      "enum": [
        "CLOSED",
        "BLOCKED",
        "CHANGE_PROPOSED",
        "NOT_CONFIRMED",
        "USER_DECISION_REQUIRED",
        "NO_ACTION"
      ]
    },
    "research_state_unchanged": {"const": true},
    "no_private_chain_of_thought": {"const": true}
  },
  "allOf": [
    {
      "if": {
        "properties": {"mode": {"const": "STRATEGY_LAUNDERING"}},
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "finding": {
            "properties": {
              "semantic_identity": {"$ref": "#/$defs/semanticIdentity"},
              "equivalent_attempt_count": {"type": "integer", "minimum": 2}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"corrective_action": {"properties": {"status": {"const": "APPLIED"}}}},
        "required": ["corrective_action"]
      },
      "then": {
        "properties": {
          "regression": {
            "properties": {"result": {"const": "PASS"}}
          },
          "disposition": {"enum": ["CLOSED", "NO_ACTION"]}
        }
      }
    },
    {
      "if": {
        "properties": {"disposition": {"const": "CLOSED"}},
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "regression": {
            "properties": {"result": {"const": "PASS"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"disposition": {"const": "CHANGE_PROPOSED"}},
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "finding": {
            "properties": {
              "material_state_change": {
                "enum": [
                  "VISIBLE_CHANGE_PROPOSAL",
                  "NEW_RESEARCH_VERSION",
                  "USER_DECISION_REQUIRED"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,199}$"
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "shortText": {"type": "string", "minLength": 1, "maxLength": 2000},
    "nullableShortText": {
      "oneOf": [
        {"$ref": "#/$defs/shortText"},
        {"type": "null"}
      ]
    },
    "semanticIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis",
        "expected_evidence",
        "target_failure",
        "intended_outcome"
      ],
      "properties": {
        "hypothesis": {"$ref": "#/$defs/shortText"},
        "expected_evidence": {"$ref": "#/$defs/shortText"},
        "target_failure": {"$ref": "#/$defs/shortText"},
        "intended_outcome": {"$ref": "#/$defs/shortText"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "protected_intent",
        "risk",
        "semantic_identity",
        "equivalent_attempt_count",
        "material_state_change"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["CONFIRMED", "NOT_CONFIRMED", "UNRESOLVED"]
        },
        "summary": {"$ref": "#/$defs/shortText"},
        "protected_intent": {"$ref": "#/$defs/shortText"},
        "risk": {"$ref": "#/$defs/shortText"},
        "semantic_identity": {
          "oneOf": [
            {"$ref": "#/$defs/semanticIdentity"},
            {"type": "null"}
          ]
        },
        "equivalent_attempt_count": {"type": "integer", "minimum": 1},
        "material_state_change": {
          "type": "string",
          "enum": [
            "NONE",
            "VISIBLE_CHANGE_PROPOSAL",
            "NEW_RESEARCH_VERSION",
            "USER_DECISION_REQUIRED",
            "BLOCKED",
            "UNKNOWN"
          ]
        }
      }
    },
    "correctiveAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "scope", "status", "max_attempts", "exit_condition"],
      "properties": {
        "summary": {"$ref": "#/$defs/shortText"},
        "scope": {"$ref": "#/$defs/shortText"},
        "status": {
          "type": "string",
          "enum": ["APPLIED", "RECOMMENDED", "NOT_APPLICABLE", "BLOCKED"]
        },
        "max_attempts": {"const": 1},
        "exit_condition": {"$ref": "#/$defs/shortText"}
      }
    },
    "regression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement", "method", "result", "evidence_refs"],
      "properties": {
        "requirement": {"$ref": "#/$defs/shortText"},
        "method": {"$ref": "#/$defs/shortText"},
        "result": {
          "type": "string",
          "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {"enum": ["PASS", "FAIL"]}
            },
            "required": ["result"]
          },
          "then": {"properties": {"evidence_refs": {"minItems": 1}}}
        }
      ]
    }
  }
}
