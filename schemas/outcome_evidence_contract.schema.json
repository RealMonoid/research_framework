{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-framework:schema:outcome-evidence-contract:2.0.0",
  "title": "Outcome Evidence Contract",
  "description": "Pre-test and post-test record that gives every outcome a fixed evidential role, exposes mechanical coupling, and keeps phenomenon, prediction, mechanism, and executable-edge conclusions separate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "research_id",
    "research_version",
    "status",
    "created_at",
    "updated_at",
    "outcomes",
    "transportability_by_target",
    "stage_conclusions"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "contract_id": {
      "$ref": "#/$defs/stableId"
    },
    "research_id": {
      "$ref": "#/$defs/stableId"
    },
    "research_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "FROZEN",
        "ASSESSED"
      ]
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/outcome"
      }
    },
    "transportability_by_target": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transportabilityAssessment"
      }
    },
    "validation_protocol": {
      "$ref": "#/$defs/validationProtocol"
    },
    "stage_conclusions": {
      "$ref": "#/$defs/stageConclusions"
    },
    "research_fingerprint_file": {
      "$ref": "#/$defs/fileReference"
    },
    "execution_record": {
      "$ref": "#/$defs/fileReference"
    },
    "execution_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "violations"
      ],
      "properties": {
        "status": {
          "enum": [
            "VALID",
            "INVALID_TEST"
          ]
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "DRAFT",
              "FROZEN"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "outcomes": {
            "items": {
              "properties": {
                "assessment": {
                  "properties": {
                    "result": {
                      "const": "NOT_ASSESSED"
                    },
                    "evidence_refs": {
                      "maxItems": 0
                    }
                  }
                }
              }
            }
          },
          "transportability_by_target": {
            "items": {
              "properties": {
                "status": {
                  "const": "NOT_ASSESSED"
                },
                "evidence_refs": {
                  "maxItems": 0
                }
              }
            }
          },
          "stage_conclusions": {
            "properties": {
              "phenomenon": {
                "properties": {
                  "status": {
                    "const": "UNKNOWN"
                  }
                }
              },
              "mechanism_supported": {
                "properties": {
                  "status": {
                    "const": "UNKNOWN"
                  }
                }
              },
              "forward_predictive_oos": {
                "properties": {
                  "status": {
                    "const": "UNKNOWN"
                  }
                }
              },
              "executable_net_edge": {
                "properties": {
                  "status": {
                    "const": "UNKNOWN"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ASSESSED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "outcomes": {
            "items": {
              "properties": {
                "assessment": {
                  "properties": {
                    "result": {
                      "enum": [
                        "SUPPORTED",
                        "CONTRADICTED",
                        "NON_DISCRIMINATING",
                        "INVALID_TEST"
                      ]
                    },
                    "evidence_refs": {
                      "minItems": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "FROZEN",
              "ASSESSED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "validation_protocol",
          "research_fingerprint_file"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ASSESSED"
          }
        }
      },
      "then": {
        "required": [
          "execution_record",
          "execution_validation"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "execution_record"
              ]
            },
            {
              "required": [
                "execution_validation"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,199}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "nullableStableId": {
      "oneOf": [
        {
          "$ref": "#/$defs/stableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "type": "string",
      "enum": [
        "PHENOMENON",
        "FORWARD_PREDICTIVE_OOS",
        "MECHANISM_SUPPORTED",
        "EXECUTABLE_NET_EDGE",
        "NONE"
      ]
    },
    "materialTarget": {
      "type": "string",
      "enum": [
        "PHENOMENON",
        "FORWARD_PREDICTIVE_OOS",
        "MECHANISM_SUPPORTED",
        "EXECUTABLE_NET_EDGE"
      ]
    },
    "decisionEffect": {
      "type": "string",
      "enum": [
        "MAY_SUPPORT_TARGET",
        "TARGET_NOT_SUPPORTED",
        "TARGET_BLOCKED",
        "NO_STATUS_CHANGE"
      ]
    },
    "decisionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_effect",
        "contradiction_effect",
        "non_discriminating_effect",
        "invalid_test_effect"
      ],
      "properties": {
        "support_effect": {
          "$ref": "#/$defs/decisionEffect"
        },
        "contradiction_effect": {
          "$ref": "#/$defs/decisionEffect"
        },
        "non_discriminating_effect": {
          "$ref": "#/$defs/decisionEffect"
        },
        "invalid_test_effect": {
          "$ref": "#/$defs/decisionEffect"
        }
      }
    },
    "mechanicalCoupling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "related_element_refs",
        "plain_language_risk"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "INDEPENDENT",
            "SHARED_INPUTS",
            "SHARED_REFERENCE_MODEL",
            "UNKNOWN"
          ]
        },
        "related_element_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "plain_language_risk": {
          "$ref": "#/$defs/shortText"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "INDEPENDENT"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "related_element_refs": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "SHARED_INPUTS",
                  "SHARED_REFERENCE_MODEL"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "related_element_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "outcomeAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "evidence_refs",
        "plain_language_interpretation"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "NOT_ASSESSED",
            "SUPPORTED",
            "CONTRADICTED",
            "NON_DISCRIMINATING",
            "INVALID_TEST"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "plain_language_interpretation": {
          "$ref": "#/$defs/shortText"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "NOT_ASSESSED"
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "enum": [
                  "SUPPORTED",
                  "CONTRADICTED",
                  "NON_DISCRIMINATING",
                  "INVALID_TEST"
                ]
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_id",
        "role",
        "requirement_level",
        "target",
        "observable",
        "measurement_rule",
        "reference_model_refs",
        "mechanical_coupling",
        "expected_pattern",
        "falsifier",
        "timing_relative_to_trigger",
        "rival_hypothesis_refs",
        "discriminating_assumptions",
        "multiplicity_family_ref",
        "decision_rule",
        "assessment"
      ],
      "properties": {
        "outcome_id": {
          "$ref": "#/$defs/stableId"
        },
        "role": {
          "type": "string",
          "enum": [
            "PRIMARY",
            "MECHANISM_DIAGNOSTIC",
            "ROBUSTNESS",
            "EXPLORATORY"
          ]
        },
        "requirement_level": {
          "type": "string",
          "enum": [
            "REQUIRED",
            "SUPPLEMENTARY"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "observable": {
          "$ref": "#/$defs/shortText"
        },
        "measurement_rule": {
          "$ref": "#/$defs/shortText"
        },
        "reference_model_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "mechanical_coupling": {
          "$ref": "#/$defs/mechanicalCoupling"
        },
        "expected_pattern": {
          "$ref": "#/$defs/shortText"
        },
        "falsifier": {
          "$ref": "#/$defs/shortText"
        },
        "timing_relative_to_trigger": {
          "$ref": "#/$defs/shortText"
        },
        "rival_hypothesis_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "discriminating_assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/shortText"
          }
        },
        "multiplicity_family_ref": {
          "$ref": "#/$defs/nullableStableId"
        },
        "decision_rule": {
          "$ref": "#/$defs/decisionRule"
        },
        "assessment": {
          "$ref": "#/$defs/outcomeAssessment"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "PRIMARY"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "requirement_level": {
                "const": "REQUIRED"
              },
              "target": {
                "$ref": "#/$defs/materialTarget"
              },
              "multiplicity_family_ref": {
                "$ref": "#/$defs/stableId"
              },
              "decision_rule": {
                "properties": {
                  "support_effect": {
                    "const": "MAY_SUPPORT_TARGET"
                  },
                  "contradiction_effect": {
                    "const": "TARGET_NOT_SUPPORTED"
                  },
                  "non_discriminating_effect": {
                    "const": "TARGET_BLOCKED"
                  },
                  "invalid_test_effect": {
                    "const": "TARGET_BLOCKED"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "MECHANISM_DIAGNOSTIC"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "const": "MECHANISM_SUPPORTED"
              },
              "rival_hypothesis_refs": {
                "minItems": 1
              },
              "discriminating_assumptions": {
                "minItems": 1
              },
              "multiplicity_family_ref": {
                "$ref": "#/$defs/stableId"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "MECHANISM_DIAGNOSTIC"
              },
              "requirement_level": {
                "const": "REQUIRED"
              }
            },
            "required": [
              "role",
              "requirement_level"
            ]
          },
          "then": {
            "properties": {
              "decision_rule": {
                "properties": {
                  "support_effect": {
                    "const": "MAY_SUPPORT_TARGET"
                  },
                  "contradiction_effect": {
                    "const": "TARGET_NOT_SUPPORTED"
                  },
                  "non_discriminating_effect": {
                    "const": "TARGET_BLOCKED"
                  },
                  "invalid_test_effect": {
                    "const": "TARGET_BLOCKED"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "ROBUSTNESS"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "$ref": "#/$defs/materialTarget"
              },
              "multiplicity_family_ref": {
                "$ref": "#/$defs/stableId"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "EXPLORATORY"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "requirement_level": {
                "const": "SUPPLEMENTARY"
              },
              "target": {
                "const": "NONE"
              },
              "multiplicity_family_ref": {
                "type": "null"
              },
              "decision_rule": {
                "properties": {
                  "support_effect": {
                    "const": "NO_STATUS_CHANGE"
                  },
                  "contradiction_effect": {
                    "const": "NO_STATUS_CHANGE"
                  },
                  "non_discriminating_effect": {
                    "const": "NO_STATUS_CHANGE"
                  },
                  "invalid_test_effect": {
                    "const": "NO_STATUS_CHANGE"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "transportabilityAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "tested_environments",
        "expected_stability",
        "allowed_drift",
        "status",
        "evidence_refs",
        "plain_language_scope"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/materialTarget"
        },
        "tested_environments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/shortText"
          }
        },
        "expected_stability": {
          "$ref": "#/$defs/shortText"
        },
        "allowed_drift": {
          "$ref": "#/$defs/shortText"
        },
        "status": {
          "type": "string",
          "enum": [
            "NOT_ASSESSED",
            "SUPPORTED",
            "NOT_SUPPORTED",
            "BLOCKED",
            "NOT_APPLICABLE"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "plain_language_scope": {
          "$ref": "#/$defs/shortText"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_ASSESSED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "SUPPORTED",
                  "NOT_SUPPORTED",
                  "BLOCKED"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "stageAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence_refs",
        "rationale"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "SUPPORTED",
            "NOT_SUPPORTED",
            "BLOCKED"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "rationale": {
          "$ref": "#/$defs/shortText"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "SUPPORTED",
                  "NOT_SUPPORTED",
                  "BLOCKED"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "stageConclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phenomenon",
        "mechanism_supported",
        "forward_predictive_oos",
        "executable_net_edge"
      ],
      "properties": {
        "phenomenon": {
          "$ref": "#/$defs/stageAssessment"
        },
        "mechanism_supported": {
          "$ref": "#/$defs/stageAssessment"
        },
        "forward_predictive_oos": {
          "$ref": "#/$defs/stageAssessment"
        },
        "executable_net_edge": {
          "$ref": "#/$defs/stageAssessment"
        }
      }
    },
    "validationProtocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stopping_rule": {
          "$ref": "#/$defs/stoppingRule"
        },
        "peeking_policy": {
          "enum": [
            "NO_INTERIM_STOPPING",
            "PREDECLARED_ALPHA_SPENDING",
            "FIXED_AUDITS_WITHOUT_TERMINATION"
          ]
        },
        "early_termination_allowed": {
          "type": "boolean"
        },
        "inspection_schedule": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inspectionPlan"
          }
        },
        "alpha_budget": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "justification": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "stopping_rule",
        "peeking_policy",
        "early_termination_allowed",
        "inspection_schedule"
      ]
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "stoppingRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "horizon_type": {
          "enum": [
            "FIXED_OBSERVATIONS",
            "FIXED_TRADES",
            "FIXED_CALENDAR_WINDOW",
            "HISTORICAL_STATIC_HOLDOUT"
          ]
        },
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        },
        "target_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "horizon_type",
        "start_at"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "horizon_type": {
                "enum": [
                  "FIXED_OBSERVATIONS",
                  "FIXED_TRADES"
                ]
              }
            }
          },
          "then": {
            "required": [
              "target_count"
            ],
            "not": {
              "required": [
                "end_at"
              ]
            }
          },
          "else": {
            "required": [
              "end_at"
            ],
            "not": {
              "required": [
                "target_count"
              ]
            }
          }
        }
      ]
    },
    "inspectionPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at_count": {
          "type": "integer",
          "minimum": 0
        },
        "at_time": {
          "type": "string",
          "format": "date-time"
        },
        "alpha_increment": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "p_value_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "required": [],
      "oneOf": [
        {
          "required": [
            "at_count"
          ],
          "not": {
            "required": [
              "at_time"
            ]
          }
        },
        {
          "required": [
            "at_time"
          ],
          "not": {
            "required": [
              "at_count"
            ]
          }
        }
      ]
    }
  }
}
