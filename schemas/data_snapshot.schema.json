{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-framework:schema:data-snapshot:1.0.0",
  "title": "Immutable Market Data Snapshot",
  "description": "Unveraenderliche Referenz auf einen konkreten Datenstand. Schliesst die Luecke zwischen data_requirements (welche Daten noetig sind) und consumed_data_refs (welche Daten tatsaechlich verbraucht wurden). Ein Snapshot belegt Herkunft, Abdeckung und Integritaet; er belegt keine Datenqualitaet und keine Eignung fuer eine Hypothese.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "created_at",
    "data_kind",
    "source",
    "instrument",
    "coverage",
    "files"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "snapshot_id": { "$ref": "#/$defs/stableId" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "data_kind": {
      "type": "string",
      "enum": ["OHLCV", "TRADES", "AGG_TRADES", "FUNDING_RATE", "ORDER_BOOK", "OTHER"]
    },
    "other_kind_description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "access_method", "retrieved_at", "terms_ref"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "BINANCE_PUBLIC_DATA",
            "TARDIS",
            "COINBASE",
            "TRADINGVIEW_EXPORT",
            "BROKER_EXPORT",
            "OTHER"
          ]
        },
        "other_provider_description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "access_method": {
          "type": "string",
          "enum": ["BULK_ARCHIVE", "REST_API", "WEBSOCKET_CAPTURE", "MANUAL_EXPORT", "OTHER"]
        },
        "base_location": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "retrieved_at": { "$ref": "#/$defs/timestamp" },
        "terms_ref": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "provider_checksums_verified": { "type": "boolean" }
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["venue", "symbol", "instrument_class", "timeframe"],
      "properties": {
        "venue": { "type": "string", "minLength": 1, "maxLength": 100 },
        "symbol": { "type": "string", "minLength": 1, "maxLength": 100 },
        "instrument_class": {
          "type": "string",
          "enum": ["SPOT", "PERPETUAL", "FUTURE", "OPTION", "INDEX", "OTHER"]
        },
        "timeframe": { "type": "string", "pattern": "^(tick|[0-9]+(s|m|h|d|w|M))$" },
        "settlement_currency": { "type": "string", "minLength": 1, "maxLength": 20 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_observation",
        "last_observation",
        "row_count",
        "timezone",
        "continuity_checked",
        "gap_count"
      ],
      "properties": {
        "first_observation": { "$ref": "#/$defs/timestamp" },
        "last_observation": { "$ref": "#/$defs/timestamp" },
        "row_count": { "type": "integer", "minimum": 1 },
        "timezone": { "const": "UTC" },
        "continuity_checked": { "type": "boolean" },
        "gap_count": { "type": "integer", "minimum": 0 },
        "missing_units": { "type": "integer", "minimum": 0 },
        "gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "missing_units"],
            "properties": {
              "from": { "$ref": "#/$defs/timestamp" },
              "to": { "$ref": "#/$defs/timestamp" },
              "missing_units": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "zero_volume_rows": { "type": "integer", "minimum": 0 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "row_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "derivations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "formula", "input_columns"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "formula": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "input_columns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        }
      }
    },
    "split_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_at", "document_sha256", "method"],
      "properties": {
        "declared_at": { "$ref": "#/$defs/timestamp" },
        "document_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "method": { "type": "string", "enum": ["CHRONOLOGICAL", "BLOCKED", "OTHER"] },
        "is_boundary": { "$ref": "#/$defs/timestamp" },
        "val_boundary": { "$ref": "#/$defs/timestamp" }
      }
    },
    "known_limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    }
  },
  "allOf": [
    {
      "if": { "required": ["data_kind"], "properties": { "data_kind": { "const": "OTHER" } } },
      "then": { "required": ["other_kind_description"] }
    },
    {
      "if": {
        "required": ["source"],
        "properties": { "source": { "required": ["provider"], "properties": { "provider": { "const": "OTHER" } } } }
      },
      "then": {
        "properties": { "source": { "required": ["other_provider_description"] } }
      }
    },
    {
      "if": { "required": ["data_kind"], "properties": { "data_kind": { "const": "OHLCV" } } },
      "then": {
        "properties": { "instrument": { "properties": { "timeframe": { "not": { "const": "tick" } } } } }
      }
    },
    {
      "if": {
        "required": ["coverage"],
        "properties": { "coverage": { "required": ["gap_count"], "properties": { "gap_count": { "minimum": 1 } } } }
      },
      "then": {
        "properties": { "coverage": { "required": ["gaps", "missing_units"], "properties": { "gaps": { "minItems": 1 } } } }
      }
    },
    {
      "if": {
        "required": ["coverage"],
        "properties": { "coverage": { "required": ["continuity_checked"], "properties": { "continuity_checked": { "const": false } } } }
      },
      "then": {
        "properties": { "coverage": { "properties": { "gap_count": { "const": 0 } } } },
        "required": ["known_limitations"]
      }
    }
  ],
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
